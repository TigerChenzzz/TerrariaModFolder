	Tooltip: ""

	Custom: {
		Label: Custom
		Tooltip: Custom order for folders and mods
	}

	RecentlyUpdated: {
		Label: Recently Updated
		Tooltip: "{$tModLoader.ModsSortRecently}"
	}

	OldlyUpdated: {
		Label: Oldly Updated
		Tooltip: Sort by oldest changed
	}

	DisplayNameAtoZ: {
		Label: Alphabetical
		Tooltip: "{$tModLoader.ModsSortNamesAlph}"
	}

	DisplayNameZtoA: {
