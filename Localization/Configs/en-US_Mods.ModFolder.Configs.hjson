CommonConfig: {
	DisplayName: Config

	LeftClickToEnterFolderSystem: {
		Label: Left Click To Enter Folder System
		Tooltip:
			'''
			when enabled, right click to enter the original mod manager
			when disabled, right click to enter the folder system
			'''
	}

	ShowModLocation: {
		Label: Show Mod Location
		Tooltip: show if mod is from steam workshop, local or modpack
	}

	SaveWhenChanged: {
		Label: Save When Changed
		Tooltip: if false, data would only be saved when go back
	}

	AlwaysNeedConfirmWhenDeletingFolder: {
		Label: Always Need Confirm When Deleting Folder
		Tooltip:
			'''
			when disabled, pressing Shift or Alt and click delete button would directly delete the folder's index,
			but you still need to comfirm unsubscribe all when pressing Ctrl
			'''
	}

	AutoMoveListWhenDragging: {
		Label: Auto Move List When Dragging
		Tooltip: ""
	}

	DataSavePath: {
		Label: Data Save Path
		Tooltip:
			'''
			data would be saved at the "ModFolderData.json" at the path
			if empty, data would be saved at the mod folder (where tml puts mods)
			'''
	}

	ShowModVersion: {
		Label: Show Mod Version
		Tooltip: ""
	}

	ShowEnableStatus: {
		Label: Show Enable Status Settings
		Tooltip: ""
	}

	RemoveRedundantData: {
		Label: Remove Redundant Data
		Tooltip: Remove data of mods that are neither subscribed nor in the folder system
	}

	TotallyReload: {
		Label: Totally Reload
		Tooltip: Tatally reload the folder system when entering again
	}

	LogModLoading: {
		Label: Log Mod Loading
		Tooltip: Enabling it may cause lags when loading mods
	}

	SeeChangelog: {
		Label: See Changelog
		Tooltip: ""
	}

	DefaultLayout: {
		Label: Default Layout
		Tooltip: ""
	}

	ScrollingName: {
		Label: Scrolling Name
		Tooltip: ""
	}

	ShowAllModsByDefault: {
		Label: Show All Mods By Default
		Tooltip: Or show folder system by default
	}

	FolderFilterMode: {
		Label: Folder Filter Mode
		Tooltip: How folders react to the filter
	}

	DefaultFolderModSortMode: {
		Label: Default Sort Mode Between Folders and Mods
		Tooltip: ""
	}

	DefaultSortMode: {
		Label: Default Sort Mode
		Tooltip: ""
	}

	ButtonCopyPasteConfig: {
		Label: Button Copy Paste Config
		Tooltip: ""
	}

	ShowSmallIcon: {
		Label: Show Small Icon
		Tooltip: Show small icon in stripe layout when possible
	}

	RapidDelete: {
		Label: Rapid Unsubscribe
		Tooltip:
			'''
			When unsubscribing multiple mods, enable this would unsubscribe them in a rapid but laggy way, vice versa.
			(using 1 Task per unsubscribing mod)
			'''
	}

	UseDoubleDotFolder: {
		Label: '''".." Folder'''
		Tooltip: Add a ".." folder to go to the upper folder when not at the root
	}

	UsePathMoveButtons: {
		Label: Show Go Back and Go Forward Buttons
		Tooltip:
			'''
			Show the buttons at the left of the folder path
			shortcuts still work when the buttons are not shown
			'''
	}
}

