UI: {
	Buttons: {
		Mods: {
			DescriptionToAdd: Rightclick to open the folder system.
			DescriptionWhenLeftClick: Rightclick to open the original UI.
		}

		CreateFolder.DisplayName: Create Folder

		AllMods: {
			DisplayName: Enable & Disable
			Tooltip:
				'''
				leftclick to enable mods
				rightclick to disable mods
				middle click to reset mods to the previous enabled states
				the mods are from the current folder or selected mods and folders by default
				pressing Alt to include the subfolders
				pressing Shift for all mods
				pressing Ctrl to not ignore the favorite mods
				specially, pressing Ctrl and right click is regarded as right click but not pressing Ctrl, and disable the redundant dependencies
				pressing Ctrl and middle click is regarded as right click with pressing Ctrl, and disable the redundant dependencies
				(favorite mods cannot be diabled by default)
				'''
		}

		Back.Tooltip:
			'''
			change directory up one level by default
			go back to the main menu if at the root directory
			pressing Shift to directly go to the main menu
			pressing Ctrl to force reload mods when go to the main menu
			'''

		ToggleShowButtons: {
			TooltipOn:
				'''
				show buttons
				middle click to reset to default
				'''
			TooltipOff:
				'''
				hide buttons
				middle click to reset to default
				'''
		}

		More.DisplayName: More Buttons

		CopyEnabled: {
			DisplayName: Copy Enabled
			Tooltip:
				'''
				copy enabled mods to the current folder (not available at root or showing all mods)
				by default these contains only the mods that are already enabled (loaded)
				pressing Shift for mods that would be enabled (without mods that would be disabled)
				pressing Ctrl to remove the old content
				'''
		}

		DisableRedundant: {
			DisplayName: Disable Redundant
			Tooltip:
				'''
				disable redundant dependencies (mods that have dependents but no dependent is enabled)
				the mods are from the current folder by default
				pressing Alt to also contains the subfolders
				pressing Shift for all mods
				pressing Ctrl to allow disable the favorite mods
				left click to not disable mods that have references
				right click to allow disable mods that have references
				(mods that have both dependencies and dependents like Calamity
				would be disabled in right click when no dependents on)
				'''
		}

		Subscribe: {
			Tooltips: {
				Downloading: Downloading {0} / {1}
				Subscribing: Subscribing...
				Loading: Loading...
				Subscribe: Subscribe
			}
		}

		Delete: {
			Tooltips: {
				CantDeleteEnabled: Can't unsubscribe an enabled mod
				CantDeleteInModPack: Can't unsubscribe a mod in a mod pack
			}
		}

		Update: {
			DisplayName: Update Mods
			Tooltip: ""
			UpdateItemPattern: "{0}: {1} -> {2}"
			NewItemPattern: "{0}: {1}"
			SearchingForMods: Searching for mods to update...
			DialogText: Are you sure to update the mods below?
			NoModsToUpdate: No mods to update.
		}

		Export.Tooltip:
			'''
			Export to clipboard
			Pressing Shift to not export the display names
			Pressing Ctrl to export the aliases
			Pressing Alt to export the favorite status
			'''

		CopyPaste: {
			DisplayName: Copy & Paste
			Tooltip:
				'''
				Left click to copy (Ctrl + C)
				Right click to paste (Ctrl + V)
				not avaliable when showing all mods
				The copy target is the selected if any or all in the current folder
				'''
		}

		SubscribeAll: {
			DisplayName: Subscribe All
			Tooltip:
				'''
				Subscribe all or selected unsubscribed mods in this folder
				Pressing Alt to include subfolders
				Pressing Shift for all mods
				'''
			SearchingForMods: Searching for mods to subscribe...
			NoModsToSubscribe: Not mods to subscribe.
			DialogText: Are you sure to subscribe the mods below?
		}
	}

	SortButtons: {
		FolderModSortModes: {
			Custom.Tooltip: "{$Mods.ModFolder.Configs.FolderModSortModes.Custom.Tooltip}"
			FolderFirst.Tooltip: "{$Mods.ModFolder.Configs.FolderModSortModes.FolderFirst.Tooltip}"
			ModFirst.Tooltip: "{$Mods.ModFolder.Configs.FolderModSortModes.ModFirst.Tooltip}"
		}

		FolderMenuSortModes: {
			Custom.Tooltip: "{$Mods.ModFolder.Configs.FolderMenuSortModes.Custom.Tooltip}"
			RecentlyUpdated.Tooltip: "{$Mods.ModFolder.Configs.FolderMenuSortModes.RecentlyUpdated.Tooltip}"
			OldlyUpdated.Tooltip: "{$Mods.ModFolder.Configs.FolderMenuSortModes.OldlyUpdated.Tooltip}"
			DisplayNameAtoZ.Tooltip: "{$Mods.ModFolder.Configs.FolderMenuSortModes.DisplayNameAtoZ.Tooltip}"
			DisplayNameZtoA.Tooltip: "{$Mods.ModFolder.Configs.FolderMenuSortModes.DisplayNameZtoA.Tooltip}"
		}

		ToBeEnabled.Tooltip: Show only mods to be enabled
		ToBeDisabled.Tooltip: Show only mods to be disabled
		ToBeToggled.Tooltip: Show only mods to be toggled
		WouldBeEnabled.Tooltip: Show only mods that would be enabled
		WouldBeDisabled.Tooltip: Show only mods that would be disabled
		FolderSystem.Tooltip: Use folder system
		AllMods.Tooltip: Show all mods
		Loaded.Tooltip: Show loaded mods
		Unloaded.Tooltip: Show unloaded mods
		StripeLayout.Tooltip: Stripe layout
		BlockLayout.Tooltip: Block layout
		BlockWithNameLayout.Tooltip: Block with name layout
	}

	NewFolderDefaultName: New Folder
	DeleteModItemCofirmTextToAdd:
		'''
		pressing Shift to delete the index
		pressing Ctrl to unsubscribe
		pressing both to totally delete the mod
		'''
	DeleteModItemUnloadedComfirmTextToAdd: Only delete the index, not the mod
	DeleteFolderConfirmText:
		'''
		Are you sure to delete the folder?
		pressing Shift to delete the index
		pressing Ctrl to unsubscribe all mods in the folder
		pressing Alt to delete the index while move the content to the current folder
		'''
	DeleteFolderDoubleConfirmText: Are you sure to unsubscribe all mods in the folder?
	DeleteFolderUnloadedConfirmText:
		'''
		Are you sure to delete the folder?
		the content are not loaded yet, so only the index would be deleted
		pressing Alt to move the content to the current folder
		'''
	ConfigButtons.OpenFolder.Tooltip: open folder...
	Rename: Rename
	FolderEnableStatus:
		'''
		all mods: {0}
		enabled: {1}
		to enable: {2}
		to disable: {3}
		'''
	CycleImageDisabled:
		'''
		[c/999999:Not usable currently]
		[c/999999:{0}]
		'''
	FilteredByLoaded: "{0} mods filtered by loaded filter."
	FilteredByContent: "{0} folders filtered by content filter."

	PopupInfos: {
		CantSubscribeForMissingPublishId: Can't subscribe! No mod info stored!
		CantSubscribeWhenDownloading: Downloading mod!
		CantSubscribeWhenSubscribing: Already subscribing! Don't repeatly click!
		CantSubscribeWhenLoading: Can't subscibe when loading! Please wait for loading complete!
		Exported: Folder content exported to clipboard!
		ImportNotAllowedWhenShowingAllMods: Import is not allowed when showing all mods, please use folder system!
		CopyPasteNotAllowedWhenShowingAllMods: Copy & Paste is not allowed when showing all mods, please use folder system!
		NotAnyItemCopied: Not any item can be copied.
		Imported: The clipboard content has been pasted to the current folder.
		ImportClipboardInvalid: The clipboard content is invalid!
		ImportVersionNotImplemented: The importing function of the data's version is not implemented!
		ImportInvalidVersion: The json data's "Version" is invalid!
		SelectedItemsCopied: The selected items are copied to the clipboard.
		AllItemsInTheFolderCopied: All items in the folder are copied to the clipboard.
		SteamNotAvailable: Steam not available!
		DownloadModError: Download mods error! See log for more detailed info.
		CantFindModInWorkshop: Can't find the mod in workshop: {0} ({1})
		CantFindModInWorkshopWithoutDisplayName: Can't find the mod in workshop: {0}
		NoPublishIdStored: No Publish ID stored for mod: {0} ({1})
		NoPublishIdStoredWithoutDisplayName: No Publish ID stored for mod: {0}
		EnableNotAllowedWhenLoading: Can't enable mods when loading!
		DisableNotAllowedWhenLoading: Can't disable mods when loading!
		ResetNotAllowedWhenLoading: Can't reset mods when loading!
	}
}
